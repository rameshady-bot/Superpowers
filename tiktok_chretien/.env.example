# ══════════════════════════════════════════════
#  TIKTOK CHRÉTIEN — Configuration
# ══════════════════════════════════════════════

# ── Pexels API (téléchargement vidéos de fond) ─
# Clé gratuite sur https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# ── Pixabay API (alternative à Pexels) ─────────
# Clé gratuite sur https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key_here

# ── Voix off ────────────────────────────────────
# Voix edge-tts préférée (liste : edge-tts --list-voices)
VOICE_PRIMARY=fr-FR-DeniseNeural
# Fallback hors ligne si edge-tts indisponible
VOICE_FALLBACK=fr

# ── Whisper ─────────────────────────────────────
# Modèle : tiny | base | small | medium | large
WHISPER_MODEL=base

# ── Vidéo ───────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Volumes (0.0 → 1.0)
MUSIC_VOLUME=0.15
VOICE_VOLUME=1.0

# ── Sous-titres ─────────────────────────────────
SUBTITLE_FONT_SIZE=64
SUBTITLE_COLOR=white
SUBTITLE_STROKE_COLOR=black
SUBTITLE_STROKE_WIDTH=3
SUBTITLE_POSITION=0.74
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ── Référence biblique (bandeau doré en haut) ───
VERSET_FONT_SIZE=42
VERSET_COLOR=#FFD700

# ── Dossiers ────────────────────────────────────
VIDEOS_DIR=assets/videos
MUSIC_DIR=assets/music
TEMP_DIR=temp
OUTPUT_DIR=output
SESSIONS_DIR=sessions
