# Copy this file to .env and fill in your values.
# Source it before running: source .env

# Required — get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional — absolute path to a royalty-free MP3 for background music
# If unset or file doesn't exist, video uses voice-over only.
# BG_MUSIC_PATH=/path/to/your/music.mp3

# Optional overrides
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
