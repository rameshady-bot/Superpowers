# Copy this to .env and fill in your values — NEVER commit .env to git.
# source: https://www.pexels.com/api/  (free, 200 req/hour)
PEXELS_API_KEY=your_pexels_api_key_here

# source: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: absolute path to a royalty-free MP3.
# Leave unset or empty to skip background music.
# BG_MUSIC_PATH=/absolute/path/to/music.mp3

# Optional: override font paths (must be .ttf files readable by FFmpeg)
# FONT_BOLD=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
# FONT_ITALIC=/usr/share/fonts/truetype/liberation/LiberationSans-BoldItalic.ttf
