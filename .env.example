# ─────────────────────────────────────────────────────────────────────────────
# TikTok Christian Video Generator — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
#
# FREE TIER SETUP (zero cost to start):
#   1. Set SADTALKER_PATH + SOURCE_IMAGE_PATH  → free video generation
#   2. Set ELEVENLABS_API_KEY + VOICE_ID       → 10 000 free chars/month
#      (gTTS kicks in automatically when quota is exhausted — no config needed)
#   3. Set ANTHROPIC_API_KEY                   → ~$0.002/video (negligible)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (Claude) — REQUIRED ─────────────────────────────────────────────
# Script generation. ~$0.002 per video. No free tier, but recharge min $5.
# Get your key at: platform.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ── ElevenLabs — OPTIONAL (10 000 chars/month free) ───────────────────────────
# Best voice quality. When quota runs out, gTTS takes over automatically.
# Leave blank to always use gTTS (completely free).
# Get your key at: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=

# Voice ID for a warm French-speaking voice.
# Find IDs: elevenlabs.io → Voice Library → search "French" → copy ID from URL
ELEVENLABS_VOICE_ID=

# ── SadTalker — RECOMMENDED (100% free, local) ────────────────────────────────
# The main free video backend. Generates talking-head video from a photo + audio.
#
# Setup (one-time):
#   git clone https://github.com/OpenTalker/SadTalker.git /path/to/SadTalker
#   cd /path/to/SadTalker
#   pip install -r requirements.txt
#   bash scripts/download_models.sh     # downloads ~2 GB of model weights
#
# Then set the two vars below:
SADTALKER_PATH=/path/to/SadTalker

# Path to a face photo of your avatar (JPG or PNG, frontal, well-lit)
# Choose a diverse, approachable person (25–40 years old, non-pastor look)
SOURCE_IMAGE_PATH=/path/to/avatar_photo.jpg

# ── D-ID — OPTIONAL fallback (5 free videos at signup) ───────────────────────
# Used only if SadTalker fails. Free trial gives 5 videos.
# Get your key at: studio.d-id.com → Settings → API Key
DID_API_KEY=

# D-ID presenter ID — see docs.d-id.com/reference/presenters
DID_PRESENTER_ID=amy-jcwCkr1

# ── HeyGen — OPTIONAL fallback (1 credit at signup) ──────────────────────────
# Last resort. Free trial is very limited.
# Get your key at: heygen.com → Settings → API
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# ── Optional overrides ────────────────────────────────────────────────────────
MAX_RETRIES=3
LOG_LEVEL=INFO

# Whisper model: tiny | base | small | medium | large
# "base" is free and works well for French. "small" is better but slower.
WHISPER_MODEL=base
