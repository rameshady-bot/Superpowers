# ═══════════════════════════════════════════════════════
#  CONFIGURATION DU PIPELINE VIDÉO CHRÉTIEN TIKTOK
# ═══════════════════════════════════════════════════════

# ── Claude API (optionnel — uniquement si --use-claude) ──
ANTHROPIC_API_KEY=sk-ant-votre-clé-ici
CLAUDE_MODEL=claude-sonnet-4-6

# ── TikTok ───────────────────────────────────────────────
# Mode de publication : "playwright" (recommandé) ou "api"
TIKTOK_MODE=playwright
# Uniquement si TIKTOK_MODE=api :
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Voix off (espeak-ng, hors ligne) ─────────────────────
VOICE_ID=fr            # fr | fr-be | fr-ch | en | es | de
VOICE_RATE=145         # Débit en mots/min (120=lent, 170=rapide)
VOICE_PITCH=50         # Hauteur 0-99

# ── Vidéo ─────────────────────────────────────────────────
VIDEO_FPS=30

# Volume musique de fond (0.0 = muet, 1.0 = plein)
MUSIC_VOLUME=0.18
VOICEOVER_VOLUME=1.0

# Sous-titres
SUBTITLE_FONT_SIZE=62
SUBTITLE_COLOR=white
SUBTITLE_STROKE_COLOR=black
SUBTITLE_STROKE_WIDTH=3
SUBTITLE_Y_RATIO=0.72   # Position verticale (0=haut, 1=bas)

# Référence biblique (en haut)
VERSET_FONT_SIZE=44
VERSET_COLOR=#FFD700

# Police (chemin absolu)
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ── Dossiers (chemins relatifs au projet) ─────────────────
ASSETS_DIR=assets
VIDEOS_DIR=assets/videos
MUSIC_DIR=assets/music
TEMP_DIR=temp
OUTPUT_DIR=output
SESSIONS_DIR=sessions
LOGS_DIR=logs
