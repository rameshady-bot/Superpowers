# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === TikTok API (officiel) ===
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_ACCESS_TOKEN=your_access_token

# === Configuration vidéo ===
VIDEO_LANGUAGE=fr
VOICE_NAME=fr-FR-DeniseNeural
# Autres voix FR : fr-FR-HenriNeural, fr-BE-CharlineNeural

# === Chemins (optionnel, valeurs par défaut utilisées sinon) ===
ASSETS_DIR=assets
TEMP_DIR=temp
OUTPUT_DIR=output
SESSIONS_DIR=sessions
LOGS_DIR=logs

# === Mode publication TikTok ===
# "api" pour l'API officielle, "playwright" pour le navigateur automatisé
TIKTOK_MODE=playwright

# === Claude Model ===
CLAUDE_MODEL=claude-sonnet-4-6
