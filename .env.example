# ─────────────────────────────────────────────────────────────────────────────
# TikTok Christian Video Generator — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Used for script generation.
# Get your key at: platform.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# Used for French voiceover synthesis.
# Get your key at: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=REPLACE_ME

# Voice ID for a warm French-speaking voice.
# Find IDs at: elevenlabs.io → Voice Library → copy ID from URL
# Recommended voices for FR warm tone: search "French" in Voice Library
ELEVENLABS_VOICE_ID=REPLACE_ME

# ── HeyGen (Primary video) ────────────────────────────────────────────────────
# Used for talking-head video generation with lip-sync.
# Get your key at: heygen.com → Settings → API
HEYGEN_API_KEY=REPLACE_ME

# Avatar ID — must be a licensed avatar from your HeyGen account.
# Find IDs at: app.heygen.com → Avatars → copy avatar ID
# Choose a diverse, approachable avatar (25–40 years old, non-pastor aesthetic)
HEYGEN_AVATAR_ID=REPLACE_ME

# ── D-ID (Fallback video) ─────────────────────────────────────────────────────
# Used as fallback when HeyGen quota is exceeded.
# Get your key at: studio.d-id.com → Settings → API Key
DID_API_KEY=REPLACE_ME

# D-ID presenter ID (default is Amy — change to match your licence)
# See available presenters at: docs.d-id.com/reference/presenters
DID_PRESENTER_ID=amy-jcwCkr1

# ── Optional overrides ────────────────────────────────────────────────────────
# Number of retry attempts for API calls (default: 3)
MAX_RETRIES=3

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower. "base" works well for French.
WHISPER_MODEL=base
